def currentUnixTime():
    return int(datetime.now(pytz.utc).timestamp())

from datetime import timezone, timedelta

def unixToPST(unix_timestamp):
    pst = timezone(timedelta(hours=-8))  # Fixed PST
    dt = datetime.utcfromtimestamp(int(unix_timestamp)).replace(tzinfo=timezone.utc).astimezone(pst)
    return dt.strftime("%Y-%m-%d %H:%M:%S PST")

def fetchRecords(connection, query, params=None):
    try:
        cursor = connection.cursor()
        cursor.execute(query, params or ())
        records = [row[0] for row in cursor.fetchall()]
        cursor.close()
        return records
    except Exception as e:
        print(f"Error fetching records: {e}")
        return []

def convert_moisture_to_rh(moisture_value):
    return min(max(moisture_value * 10, 0), 100)  # Basic placeholder conversion

def calculateKWH(readings):
    if not readings:
        return 0
    reading_sum = sum(readings)
    count = len(readings)
    return ((reading_sum - (2.5 * count)) / 0.185) * 120 / 60 / 1000

def query1(connection):
    device = device_tree.search("refrigerator_1")
    if not device:
        return "Device metadata not found."

    try:
        now_unix = currentUnixTime()
        three_hours_ago_unix = now_unix - (3 * 60 * 60)
        moisture_sensor = device['sensors']['moisture']

        records = fetchRecords(
            connection,
            """
            SELECT payload FROM "Assignment 8_virtual"
            WHERE payload->>'board_name' = %s
            AND (payload->>'timestamp')::numeric BETWEEN %s AND %s
            """,
            (device['board_name'], three_hours_ago_unix, now_unix)
        )

        moisture_readings, timestamps = [], []
        for record in records:
            if moisture_sensor in record:
                try:
                    raw = float(record[moisture_sensor])
                    moisture_readings.append(convert_moisture_to_rh(raw))
                except:
                    continue
            if 'timestamp' in record:
                try:
                    timestamps.append(int(record['timestamp']))
                except:
                    continue

        if not moisture_readings:
            return "No RH data found for refrigerator_1."

        avg_rh = sum(moisture_readings) / len(moisture_readings)
        min_time = unixToPST(min(timestamps)) if timestamps else "N/A"
        max_time = unixToPST(max(timestamps)) if timestamps else "N/A"

        return (f"Average RH in kitchen fridge (past 3 hours): {avg_rh:.2f}% RH\n"
                f"Time period: {min_time} to {max_time}")

    except Exception as e:
        return f"Error: {str(e)}"

