# Binary Search Tree Node for Device Metadata
class DeviceNode:
    def __init__(self, key, metadata):
        self.key = key
        self.metadata = metadata
        self.left = None
        self.right = None

class DeviceMetadataBST:
    def __init__(self):
        self.root = None

    def insert(self, key, metadata):
        self.root = self._insert(self.root, key, metadata)

    def _insert(self, node, key, metadata):
        if node is None:
            return DeviceNode(key, metadata)
        if key < node.key:
            node.left = self._insert(node.left, key, metadata)
        elif key > node.key:
            node.right = self._insert(node.right, key, metadata)
        return node

    def search(self, key):
        return self._search(self.root, key)

    def _search(self, node, key):
        if node is None:
            return None
        if key == node.key:
            return node.metadata
        elif key < node.key:
            return self._search(node.left, key)
        else:
            return self._search(node.right, key)

