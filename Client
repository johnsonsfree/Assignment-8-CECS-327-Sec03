
import socket

queries = [
    "What is the average moisture inside my kitchen fridge in the past three hours?",
    "What is the average water consumption per cycle in my smart dishwasher?",
    "Which device consumed more electricity among my three IoT devices (two refrigerators and a dishwasher)?"
]

server_ip = input("Enter the server IP (use the EXTERNAL IP of the server VM): ")
port = int(input("Enter port (e.g., 12345): "))

client_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)

try:
    client_socket.connect((server_ip, port))
    print(f"Connected to {server_ip}:{port}")
except Exception as e:
    print(f"Failed to connect: {e}")
    exit()

print("\nWelcome to the Smart IoT Query System!")
print("You can ask one of the following questions:")
for i, query in enumerate(queries, 1):
    print(f"{i}. {query}")
print("Type the number (1–3), or type 'exit' to quit.\n")

while True:
    user_input = input("Enter query number (1–3), or 'exit': ").strip()

    if user_input.lower() == "exit":
        break

    if user_input in {"1", "2", "3"}:
        client_socket.sendall(user_input.encode())
        data = client_socket.recv(4096)
        print(f"\nServer replied:\n{data.decode()}\n")
    else:
        print("Invalid input. Please enter 1, 2, or 3, or 'exit' to quit.\n")

client_socket.close()
print("Connection closed.")
